<UserControl x:Class="EduKit.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="GreetingText" Text="你好，电教委" Style="{StaticResource H1}" />
                    <TextBlock x:Name="DateText" Text="" Style="{StaticResource Sub}" Margin="0,6,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBell}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NoticePreview" Text="" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 时间 / 课程 / 值日 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="现在时间" Style="{StaticResource Sub}" />
                        <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="52" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
                        <TextBlock x:Name="WeekText" Text="" Style="{StaticResource Body}" Margin="0,2,0,0" />
                        <Button Content="打开课堂计时" Style="{StaticResource BtnPrimarySmall}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="Timer_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="今日课程" Style="{StaticResource H3}" />
                            <Button Content="编辑" Style="{StaticResource BtnSubtleSmall}" HorizontalAlignment="Right"
                                    Click="Timetable_Click" />
                        </Grid>
                        <ItemsControl x:Name="TodayCourses">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoCourseText" Text="今天还没有课程，点击「编辑」填写课程表。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="本周值日" Style="{StaticResource H3}" />
                            <Button Content="查看全部" Style="{StaticResource BtnSubtleSmall}"
                                    HorizontalAlignment="Right" Click="Duty_Click" />
                        </Grid>
                        <StackPanel>
                            <TextBlock x:Name="DutyGroupText" Text="—" Style="{StaticResource H2}" />
                            <TextBlock x:Name="DutyMembersText" Text="" Style="{StaticResource Sub}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 快捷操作 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Timer_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTimer}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="课堂计时" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="倒计时 / 秒表" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Random_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRoster}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="随机点名" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="课堂提问抽取" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Share_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconShare}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="局域网快传" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="手机传文件到电脑" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Display_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDisplay}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="显示与投影" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="复制 / 扩展投影" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Audio_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconVolume}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="音量控制" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="静音与媒体播放" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Notice_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBell}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="全屏公告" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="投影显示提醒文字" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="Screenshot_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconScreen}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="截图保存" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="保存当前屏幕" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="182" Height="78" Margin="0,0,10,10"
                                Click="MonitorOff_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPower}" Width="17" Height="17"
                                          Fill="{DynamicResource Accent}" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="关闭显示器" Style="{StaticResource H3}" Margin="9,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="省电不关机" Style="{StaticResource Caption}" Margin="26,4,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 系统概览 -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="本机概览" Style="{StaticResource H3}" />
                        <Button Content="系统工具" Style="{StaticResource BtnSubtleSmall}"
                                HorizontalAlignment="Right" Click="System_Click" />
                    </Grid>
                    <ItemsControl x:Name="OverviewList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
