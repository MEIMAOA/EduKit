<UserControl x:Class="EduKit.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EduKit.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="系统概览" Style="{StaticResource H1}" />
                <TextBlock x:Name="MachineText" Text="" Style="{StaticResource Sub}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="AdminChip" Style="{StaticResource Chip}" Background="{DynamicResource BgHover}">
                    <TextBlock x:Name="AdminText" Text="普通权限" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                </Border>
                <Border x:Name="TubaChip" Style="{StaticResource Chip}" Background="{DynamicResource BgHover}"
                        Margin="8,0,0,0">
                    <TextBlock x:Name="TubaChipText" Text="图吧工具箱未检测到" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                </Border>
                <Button Content="刷新" Style="{StaticResource BtnSmall}" Margin="12,0,0,0" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <controls:SmoothScrollViewer Grid.Row="1">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="处理器" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource H3}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="内存" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource H3}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="显卡" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="GpuText" Text="—" Style="{StaticResource H3}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="系统" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="OsText" Text="—" Style="{StaticResource H3}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="UptimeText" Text="" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="磁盘空间" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="DiskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock FontSize="12">
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label}" Foreground="{DynamicResource TextTertiary}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Height="7"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding FreePercent, Mode=OneWay}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="设备问题" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="DeviceList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoDeviceText" Text="没有发现驱动异常的设备。"
                                       Style="{StaticResource Caption}" Visibility="Collapsed" />
                            <Button Content="打开设备管理器" Style="{StaticResource BtnSubtleSmall}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="DeviceManager_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="图吧工具箱" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="TubaPathText" Text="正在检测…" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="本项目不打包、不重新分发图吧工具箱，仅在本机已安装时提供快捷入口。"
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="打开图吧工具箱" Style="{StaticResource BtnPrimarySmall}"
                                    Click="OpenTuba_Click" />
                            <Button Content="管理工具" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="ManageTuba_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="常用工具" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Hardware_Click">
                                <StackPanel>
                                    <TextBlock Text="硬件信息" Style="{StaticResource H3}" />
                                    <TextBlock Text="CPU / 内存 / 主板 / 显卡" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Processes_Click">
                                <StackPanel>
                                    <TextBlock Text="进程管理" Style="{StaticResource H3}" />
                                    <TextBlock Text="查看与结束进程" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Startup_Click">
                                <StackPanel>
                                    <TextBlock Text="启动与服务" Style="{StaticResource H3}" />
                                    <TextBlock Text="开机启动项 / 系统服务" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Clean_Click">
                                <StackPanel>
                                    <TextBlock Text="系统维护" Style="{StaticResource H3}" />
                                    <TextBlock Text="清理 / 修复 / 磁盘" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Network_Click">
                                <StackPanel>
                                    <TextBlock Text="网络诊断" Style="{StaticResource H3}" />
                                    <TextBlock Text="Ping / DNS / 端口" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Display_Click">
                                <StackPanel>
                                    <TextBlock Text="显示与投影" Style="{StaticResource H3}" />
                                    <TextBlock Text="分辨率 / 投影模式" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Width="176" Height="74" Margin="0,0,10,10"
                                    Click="Power_Click">
                                <StackPanel>
                                    <TextBlock Text="电源管理" Style="{StaticResource H3}" />
                                    <TextBlock Text="关机 / 重启 / 定时" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:SmoothScrollViewer>
    </Grid>
</UserControl>