<UserControl x:Class="EduKit.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="网络诊断" Style="{StaticResource H1}" />
            <TextBlock Text="查看网卡与 IP 信息，测试 Ping、DNS 解析和端口连通性" Style="{StaticResource Sub}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="网络适配器" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Button Content="刷新" Style="{StaticResource BtnSubtleSmall}" HorizontalAlignment="Right"
                                    Click="Refresh_Click" />
                        </Grid>
                        <ListBox x:Name="AdapterList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardAlt}" CornerRadius="7"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                                        Background="{DynamicResource AccentSoft}" Padding="8,2">
                                                    <TextBlock Text="{Binding Status}" FontSize="10"
                                                               Foreground="{DynamicResource Accent}" />
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding IPv4}" FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding Mac}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="常用网络操作" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Content="复制本机 IP" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                    Click="CopyIp_Click" />
                            <Button Content="打开网络连接" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                    Click="OpenAdapter_Click" />
                            <Button Content="刷新 DNS 缓存" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                    Click="FlushDns_Click" />
                            <Button Content="局域网扫描" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                    Click="LanScan_Click" />
                            <Button Content="路由跟踪" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                    Click="Tracert_Click" />
                            <Button Content="编辑 hosts" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                    Click="Hosts_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="网络诊断工具" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Ping 测试" Style="{StaticResource Sub}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PingHost" Style="{StaticResource InputBox}" Text="223.5.5.5" />
                            <TextBox Grid.Column="1" x:Name="PingCount" Style="{StaticResource InputBox}"
                                     Text="4" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="开始 Ping" Style="{StaticResource BtnPrimarySmall}"
                                    Margin="8,0,0,0" Click="Ping_Click" />
                        </Grid>

                        <TextBlock Text="DNS 解析" Style="{StaticResource Sub}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DnsHost" Style="{StaticResource InputBox}" Text="www.baidu.com" />
                            <Button Grid.Column="1" Content="解析" Style="{StaticResource BtnSecondary}"
                                    Margin="8,0,0,0" Click="Dns_Click" />
                        </Grid>

                        <TextBlock Text="端口连通性" Style="{StaticResource Sub}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PortHost" Style="{StaticResource InputBox}" Text="127.0.0.1" />
                            <TextBox Grid.Column="1" x:Name="PortNumber" Style="{StaticResource InputBox}"
                                     Text="80" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="测试" Style="{StaticResource BtnSecondary}"
                                    Margin="8,0,0,0" Click="Port_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="诊断输出" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Button Content="清空" Style="{StaticResource BtnSubtleSmall}" HorizontalAlignment="Right"
                                    Click="ClearOutput_Click" />
                        </Grid>
                        <TextBox x:Name="OutputBox" Style="{StaticResource InputBox}" IsReadOnly="True"
                                 FontFamily="Consolas, Microsoft YaHei" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BgCardAlt}"
                                 VerticalContentAlignment="Top" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
