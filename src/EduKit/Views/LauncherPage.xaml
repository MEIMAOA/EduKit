<UserControl x:Class="EduKit.Views.LauncherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="快捷启动" Style="{StaticResource H1}" />
            <TextBlock Text="把常用软件、网页、文件放在这里，上课时一键打开，不用到处找"
                       Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="添加" Style="{StaticResource BtnPrimarySmall}" Click="Add_Click" />
                <Button Content="编辑" Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Click="Edit_Click" />
                <Button Content="删除" Style="{StaticResource BtnSubtleSmall}" Margin="8,0,0,0"
                        Click="Delete_Click" />
                <Border Width="1" Height="18" Background="{DynamicResource Divider}" Margin="14,0" />
                <Button Content="上移" Style="{StaticResource BtnSubtleSmall}" Click="MoveUp_Click" />
                <Button Content="下移" Style="{StaticResource BtnSubtleSmall}" Margin="6,0,0,0"
                        Click="MoveDown_Click" />
            </StackPanel>
            <Button Content="打开所选" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right"
                    Click="Open_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     MouseDoubleClick="ItemList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCardAlt}" CornerRadius="8" Padding="12,10"
                                Margin="4,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource AccentSoft}">
                                    <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Chip}"
                                        Background="{DynamicResource BgHover}" Padding="8,2">
                                    <TextBlock Text="{Binding Category}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
