<UserControl x:Class="EduKit.Views.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="显示与投影" Style="{StaticResource H1}" />
            <TextBlock Text="切换投影模式、调整分辨率、关闭显示器，教室投影出问题时先用这里排查"
                       Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="当前显示" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ResolutionText" Text="—" FontSize="38" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <StackPanel Margin="0,10,0,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="刷新率" Style="{StaticResource Sub}" />
                            <TextBlock x:Name="RefreshText" Style="{StaticResource Body}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="颜色深度" Style="{StaticResource Sub}" />
                            <TextBlock x:Name="ColorText" Style="{StaticResource Body}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="显示器数量" Style="{StaticResource Sub}" />
                            <TextBlock x:Name="MonitorText" Style="{StaticResource Body}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="关闭显示器" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                Click="TurnOff_Click" />
                        <Button Content="打开显示设置" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                Click="OpenDisplaySettings_Click" />
                        <Button Content="刷新信息" Style="{StaticResource BtnSubtleSmall}" Margin="0,0,8,8"
                                Click="Refresh_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="投影模式（Win + P）" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Style="{StaticResource TileButton}" Width="206" Height="74" Margin="0,0,10,10"
                                Tag="internal" Click="Mode_Click">
                            <StackPanel>
                                <TextBlock Text="仅电脑屏幕" Style="{StaticResource H3}" />
                                <TextBlock Text="投影仪不显示" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="206" Height="74" Margin="0,0,10,10"
                                Tag="clone" Click="Mode_Click">
                            <StackPanel>
                                <TextBlock Text="复制" Style="{StaticResource H3}" />
                                <TextBlock Text="投影与电脑相同" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="206" Height="74" Margin="0,0,10,10"
                                Tag="extend" Click="Mode_Click">
                            <StackPanel>
                                <TextBlock Text="扩展" Style="{StaticResource H3}" />
                                <TextBlock Text="投影作为第二屏" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Width="206" Height="74" Margin="0,0,10,10"
                                Tag="external" Click="Mode_Click">
                            <StackPanel>
                                <TextBlock Text="仅投影仪" Style="{StaticResource H3}" />
                                <TextBlock Text="电脑黑屏" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="提示：切换后如果投影没有画面，检查 VGA / HDMI 线是否插紧，或按 Win + P 重新选择。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="分辨率" Style="{StaticResource SectionTitle}" Margin="0" />
                    <StackPanel x:Name="PendingPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <TextBlock x:Name="PendingText" Text="" Style="{StaticResource Body}"
                                   Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
                        <Button Content="保留更改" Style="{StaticResource BtnPrimarySmall}" Margin="12,0,0,0"
                                Click="Keep_Click" />
                        <Button Content="还原" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                Click="Revert_Click" />
                    </StackPanel>
                </Grid>
                <ListBox x:Name="ModeList" Background="Transparent" BorderThickness="0"
                         Height="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource PlainListItem}"
                         SelectionChanged="ModeList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCardAlt}" CornerRadius="6" Padding="12,8"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="应用所选分辨率" Style="{StaticResource BtnPrimarySmall}" Click="Apply_Click" />
                    <TextBlock x:Name="ModeHint" Text="选择后点击应用，15 秒内可还原。" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
