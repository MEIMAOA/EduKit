<UserControl x:Class="EduKit.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="设置与关于" Style="{StaticResource H1}" />
            <TextBlock Text="主题外观、开机启动、局域网端口和软件更新" Style="{StaticResource Sub}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="DarkSwitch" Content="使用深色主题" Style="{StaticResource Switch}"
                                      Click="Dark_Click" />
                            <TextBlock Text="深色主题在晚上或光线较暗的教室更护眼。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="AutoStartSwitch" Content="开机自动启动" Style="{StaticResource Switch}"
                                      Click="AutoStart_Click" />
                            <TextBlock Text="写入当前用户的启动项（注册表 Run），不需要管理员权限。"
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource SectionTitle}" />
                            <Button Content="打开数据文件夹" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="OpenData_Click" />
                            <Button Content="恢复默认设置" Style="{StaticResource BtnSubtle}"
                                    HorizontalAlignment="Stretch" Click="Reset_Click" />
                            <TextBlock x:Name="DataPathText" Text="" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="关于 EduKit" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Image Source="Assets/EduKit.ico" Width="46" Height="46" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="电教委工具箱" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="VersionText" Text="v1.1.0" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Body}" LineHeight="22"
                                       Text="面向班级电教委员（电教委）的 Windows 桌面工具箱，支持 Windows 7 SP1 / 8 / 10 / 11。" />
                            <Button Content="打开 GitHub 开源仓库" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="Github_Click" />
                            <TextBlock Text="开源协议：PolyForm Noncommercial 1.0.0（禁止商业使用）" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="检查更新" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="从 GitHub Releases 获取最新版本信息。" Style="{StaticResource Sub}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CheckButton" Content="检查更新" Style="{StaticResource BtnPrimarySmall}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="CheckUpdate_Click" />
                            <TextBlock x:Name="UpdateText" Text="" Style="{StaticResource Body}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
