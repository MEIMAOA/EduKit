<UserControl x:Class="EduKit.Views.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="音量控制" Style="{StaticResource H1}" />
            <TextBlock Text="调节系统音量、静音，控制音乐播放，上课前先确认音量别炸麦"
                       Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="28">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="系统主音量" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="VolumeText" Text="—" FontSize="76" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}"
                            Minimum="0" Maximum="100" Margin="16,10,16,0"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <CheckBox x:Name="MuteSwitch" Content="静音" Style="{StaticResource Switch}"
                                  Click="Mute_Click" />
                    </StackPanel>

                    <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Content="20%" Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Tag="20"
                                Click="Preset_Click" />
                        <Button Content="50%" Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Tag="50"
                                Click="Preset_Click" />
                        <Button Content="80%" Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Tag="80"
                                Click="Preset_Click" />
                        <Button Content="100%" Style="{StaticResource BtnSmall}" Margin="0,0,8,8" Tag="100"
                                Click="Preset_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="AudioHint" Text="" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="媒体控制" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BtnSecondary}" Height="52"
                                    Margin="0,0,6,0" Click="Previous_Click" ToolTip="上一首">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource TextPrimary}"
                                      Width="16" Height="16" Stretch="Uniform">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="52"
                                    Margin="0,0,6,0" Click="PlayPause_Click" ToolTip="播放 / 暂停">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource TextOnAccent}"
                                      Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource BtnSecondary}" Height="52"
                                    Margin="0,0,6,0" Click="Next_Click" ToolTip="下一首">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource TextPrimary}"
                                      Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource BtnSecondary}" Height="52"
                                    Click="Stop_Click" ToolTip="停止">
                                <Path Data="{StaticResource IconStop}" Fill="{DynamicResource TextPrimary}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <Button Content="打开音量合成器" Style="{StaticResource BtnSecondary}"
                                HorizontalAlignment="Stretch" Margin="0,14,0,0" Click="OpenMixer_Click" />
                        <Button Content="播放测试提示音" Style="{StaticResource BtnSubtle}"
                                HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="TestSound_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="小技巧" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" LineHeight="24">
                            上课前可以用「测试提示音」确认音响是否正常；<LineBreak />
                            如果拖不动音量，说明系统音频服务异常，可重启电脑或在服务里重启 Windows Audio。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
