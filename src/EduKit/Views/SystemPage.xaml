<UserControl x:Class="EduKit.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EduKit.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="系统维护" Style="{StaticResource H1}" />
                <TextBlock Text="磁盘空间、缓存清理、系统文件修复与设备管理入口" Style="{StaticResource Sub}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="AdminChip" Style="{StaticResource Chip}" Background="{DynamicResource BgHover}">
                    <TextBlock x:Name="AdminText" Text="普通权限" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                </Border>
                <Button Content="刷新" Style="{StaticResource BtnSmall}" Margin="12,0,0,0" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <controls:SmoothScrollViewer Grid.Row="1">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="磁盘空间" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="DiskList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <TextBlock FontSize="13">
                                                <Run Text="{Binding Name}" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Label}" Foreground="{DynamicResource TextTertiary}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Model}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <ProgressBar Style="{StaticResource SlimProgress}" Height="7"
                                                     Minimum="0" Maximum="100" Value="{Binding FreePercent, Mode=OneWay}"
                                                     Margin="0,5,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="缓存与垃圾清理" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="CleanList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Body}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CleanHint" Text="" Style="{StaticResource Caption}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="一键清理（安全项）" Style="{StaticResource BtnPrimarySmall}"
                                    Click="CleanSafe_Click" />
                            <Button Content="清理全部" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="CleanAll_Click" />
                            <Button Content="磁盘清理" Style="{StaticResource BtnSubtleSmall}" Margin="8,0,0,0"
                                    Click="DiskCleanup_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="系统修复与诊断" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Content="系统文件检查 (SFC)" Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,8,8" Click="Sfc_Click" />
                            <Button Content="DISM 修复系统映像" Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,8,8" Click="Dism_Click" />
                            <Button Content="重置网络" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="ResetNetwork_Click" />
                            <Button Content="刷新 DNS" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="FlushDns_Click" />
                            <Button Content="系统还原" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Restore_Click" />
                            <Button Content="事件查看器" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="EventViewer_Click" />
                            <Button Content="蓝屏转储目录" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Minidump_Click" />
                            <Button Content="设备管理器" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="DeviceManager_Click" />
                            <Button Content="服务管理" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Services_Click" />
                            <Button Content="系统信息" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Msinfo_Click" />
                        </WrapPanel>
                        <TextBlock Text="SFC / DISM / 重置网络需要管理员权限，点击后会弹出 UAC 提示。"
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="系统工具与优化" Style="{StaticResource SectionTitle}" />
                        <WrapPanel>
                            <Button Content="注册表编辑器" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Regedit_Click" />
                            <Button Content="任务计划程序" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Taskschd_Click" />
                            <Button Content="本地组策略" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Gpedit_Click" />
                            <Button Content="环境变量" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="EnvVars_Click" />
                            <Button Content="性能选项" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="PerfOptions_Click" />
                            <Button Content="用户账户" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="Accounts_Click" />
                            <Button Content="电源选项" Style="{StaticResource BtnSecondary}" Margin="0,0,8,8"
                                    Click="PowerOptions_Click" />
                        </WrapPanel>

                        <TextBlock Text="电源计划" Style="{StaticResource H3}" Margin="0,14,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="切换到平衡" Style="{StaticResource BtnSmall}" Click="Balanced_Click" />
                            <Button Content="切换到高性能" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="HighPerf_Click" />
                        </StackPanel>

                        <TextBlock Text="系统报告" Style="{StaticResource H3}" Margin="0,14,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导出系统报告" Style="{StaticResource BtnSmall}" Click="ExportReport_Click" />
                            <Button Content="生成电池报告" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="BatteryReport_Click" />
                            <Button Content="创建还原点" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="RestorePoint_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:SmoothScrollViewer>
    </Grid>
</UserControl>