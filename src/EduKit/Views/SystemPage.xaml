<UserControl x:Class="EduKit.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="系统工具" Style="{StaticResource H1}" />
            <TextBlock Text="查看电脑配置，清理临时文件，截图，重启卡住的资源管理器"
                       Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="硬件与系统信息" Style="{StaticResource SectionTitle}" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="刷新" Style="{StaticResource BtnSubtleSmall}" Click="Refresh_Click" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="InfoList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Sub}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="磁盘空间" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="DiskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock FontSize="12">
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Label}" Foreground="{DynamicResource TextTertiary}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Height="7"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding FreePercent, Mode=OneWay}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="维护工具" Style="{StaticResource SectionTitle}" />
                            <Button Content="清理临时文件" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="CleanTemp_Click" />
                            <TextBlock x:Name="TempSizeText" Text="" Style="{StaticResource Caption}"
                                       Margin="0,0,0,10" />
                            <Button Content="重启资源管理器" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="RestartExplorer_Click" />
                            <Button Content="截取全屏并保存" Style="{StaticResource BtnSecondary}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="Screenshot_Click" />
                            <Button Content="打开数据文件夹" Style="{StaticResource BtnSubtle}"
                                    HorizontalAlignment="Stretch" Click="OpenData_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="系统工具入口" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <Button Content="任务管理器" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                        Click="TaskManager_Click" />
                                <Button Content="控制面板" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                        Click="ControlPanel_Click" />
                                <Button Content="设备管理器" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                        Click="DeviceManager_Click" />
                                <Button Content="系统信息" Style="{StaticResource BtnSmall}" Margin="0,0,8,8"
                                        Click="SystemInfo_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
