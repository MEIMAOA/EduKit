<UserControl x:Class="EduKit.Views.DiskAnalyzerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EduKit.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="磁盘分析" Style="{StaticResource H1}" />
            <TextBlock Text="分析目录占用与最大的文件，快速找到占满磁盘的“元凶”"
                       Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PathBox" Style="{StaticResource InputBox}" Width="360" Text="C:\" />
                <Button Content="浏览…" Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Click="Browse_Click" />
                <Button x:Name="StartButton" Content="开始分析" Style="{StaticResource BtnPrimarySmall}" Margin="8,0,0,0"
                        Click="Start_Click" />
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource BtnSubtleSmall}" Margin="8,0,0,0"
                        Click="Cancel_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="目录占用（前 30 个）" Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="DirList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Minimum="0"
                                                 Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="最大的文件（前 100 个）" Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="FileList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Body}"
                                               VerticalAlignment="Top" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
