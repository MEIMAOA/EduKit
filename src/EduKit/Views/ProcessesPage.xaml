<UserControl x:Class="EduKit.Views.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="进程管理" Style="{StaticResource H1}" />
            <TextBlock Text="查看正在运行的程序与内存占用，结束卡死的进程" Style="{StaticResource Sub}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Width="240"
                         TextChanged="SearchBox_TextChanged" />
                <Button Content="刷新" Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Click="Refresh_Click" />
                <Button Content="结束进程" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Click="Kill_Click" />
                <Button Content="打开文件位置" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                        Click="OpenLocation_Click" />
            </StackPanel>
            <TextBlock x:Name="CountText" Text="" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Id}" FontFamily="Consolas"
                                       Style="{StaticResource Body}" />
                            <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Body}" />
                            <TextBlock Grid.Column="3" Text="{Binding Company}" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding Path}" Style="{StaticResource Caption}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>