<UserControl x:Class="EduKit.Views.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="课堂计时" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Background="{DynamicResource AccentSoft}">
                    <TextBlock Text="投影全屏显示" FontSize="11" Foreground="{DynamicResource Accent}" />
                </Border>
            </StackPanel>
            <TextBlock Text="倒计时、秒表与下课提醒，可以在投影上全屏显示" Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 计时主卡片 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Accent}">
                                <TextBlock.Text>
                                    <Binding Path="ModeText" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource BgHover}">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Text>
                                    <Binding Path="Status" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Display}"
                               FontSize="128"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextOptions.TextFormattingMode="Display" />

                    <StackPanel Grid.Row="2">
                        <ProgressBar Style="{StaticResource SlimProgress}" Height="10"
                                     Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button x:Name="StartButton" Content="开始" Style="{StaticResource BtnPrimary}"
                                    Width="132" Height="44" FontSize="15" Click="Start_Click" />
                            <Button Content="重置" Style="{StaticResource BtnSecondary}" Width="104" Height="44"
                                    FontSize="14" Margin="12,0,0,0" Click="Reset_Click" />
                            <Button Content="全屏投影" Style="{StaticResource BtnSecondary}" Height="44" FontSize="14"
                                    Margin="12,0,0,0" Padding="20,0" Click="Fullscreen_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧设置 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="快速预设" Style="{StaticResource SectionTitle}" />
                        <WrapPanel x:Name="PresetPanel" />
                        <TextBlock Text="自定义分钟数" Style="{StaticResource Sub}" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomMinutes" Style="{StaticResource InputBox}" Text="12" />
                            <Button Grid.Column="1" Content="设定" Style="{StaticResource BtnSecondary}"
                                    Margin="8,0,0,0" Click="Custom_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="计时选项" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="StopwatchSwitch" Content="使用秒表（正计时）" Style="{StaticResource Switch}"
                                  Click="Stopwatch_Click" />
                        <CheckBox x:Name="SoundSwitch" Content="结束时播放提示音" Style="{StaticResource Switch}"
                                  Margin="0,12,0,0" Click="Sound_Click" />
                        <TextBlock Text="提示音使用系统蜂鸣器，教室电脑一般都能听到。"
                                   Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
