<Window x:Class="EduKit.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduKit 全屏显示"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#0B0F14"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid Background="#0B0F14">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
            <TextBlock x:Name="MainText"
                       Text="00:00"
                       FontSize="180"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock x:Name="SubText"
                       Text=""
                       FontSize="26"
                       Foreground="#7F93A8"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock Text="按 Esc 或点击任意位置退出全屏"
                       FontSize="13"
                       Foreground="#3D4A58"
                       HorizontalAlignment="Center"
                       Margin="0,46,0,0" />
        </StackPanel>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,24,0"
                Background="#151C24" CornerRadius="14" Padding="12,5">
            <TextBlock Text="电教委工具箱 · EduKit" FontSize="11" Foreground="#5D7186" />
        </Border>
    </Grid>
</Window>
