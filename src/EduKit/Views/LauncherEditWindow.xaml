<Window x:Class="EduKit.Views.LauncherEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷方式"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText" Text="添加快捷方式" Style="{StaticResource H2}" />
            <TextBlock Text="目标可以是程序路径、网址、文件夹或 shell: 开头的系统位置"
                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="名称" Style="{StaticResource Sub}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" />

            <TextBlock Text="目标（程序 / 网址 / 文件路径）" Style="{StaticResource Sub}" Margin="0,14,0,6" />
            <TextBox x:Name="TargetBox" Style="{StaticResource InputBox}" />

            <TextBlock Text="启动参数（可选）" Style="{StaticResource Sub}" Margin="0,14,0,6" />
            <TextBox x:Name="ArgsBox" Style="{StaticResource InputBox}" />

            <TextBlock Text="分类（可选）" Style="{StaticResource Sub}" Margin="0,14,0,6" />
            <TextBox x:Name="CategoryBox" Style="{StaticResource InputBox}" Text="常用" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource BtnSecondary}" Width="92" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource BtnPrimary}" Width="92" Margin="10,0,0,0"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
