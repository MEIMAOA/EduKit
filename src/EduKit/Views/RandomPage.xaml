<UserControl x:Class="EduKit.Views.RandomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="随机点名" Style="{StaticResource H1}" />
            <TextBlock Text="课堂提问、分组随机抽取，支持不重复模式与点名记录" Style="{StaticResource Sub}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0">
                                <TextBlock x:Name="ModeChip" Text="全部同学" FontSize="11"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource BgHover}">
                                <TextBlock x:Name="CountChip" Text="共 0 人" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="ResultText" Grid.Row="1" Text="点击开始抽取"
                                   FontSize="50" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PickButton" Content="开始抽取" Style="{StaticResource BtnPrimary}"
                                    Width="150" Height="46" FontSize="15" Click="Pick_Click" />
                            <Button Content="重置" Style="{StaticResource BtnSecondary}" Width="100" Height="46"
                                    FontSize="14" Margin="12,0,0,0" Click="Reset_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="点名记录" Style="{StaticResource H3}" />
                            <Button Content="清空记录" Style="{StaticResource BtnSubtleSmall}"
                                    HorizontalAlignment="Right" Click="ClearHistory_Click" />
                        </Grid>
                        <ListBox x:Name="HistoryList" ItemContainerStyle="{StaticResource PlainListItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardAlt}" CornerRadius="5"
                                            Padding="10,6" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="学生名单" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock x:Name="RosterCount" Text="" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <TextBox x:Name="RosterBox" Style="{StaticResource MultilineBox}" Height="150"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <Button Content="保存名单" Style="{StaticResource BtnSecondary}"
                                HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="SaveRoster_Click" />
                        <TextBlock Text="每行一个名字，保存后自动用于点名与值日轮换。"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="抽取设置" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="NoRepeatSwitch" Content="不重复抽取（抽完一轮后自动重置）"
                                  Style="{StaticResource Switch}" />
                        <TextBlock Text="每次抽取人数" Style="{StaticResource Sub}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Style="{StaticResource BtnSecondary}" Width="40" FontSize="18" Click="Minus_Click" />
                            <Border Background="{DynamicResource BgCardAlt}" CornerRadius="5" Width="58"
                                    Margin="10,0" BorderBrush="{DynamicResource BorderBase}" BorderThickness="1">
                                <TextBlock x:Name="CountText" Text="1" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Content="+" Style="{StaticResource BtnSecondary}" Width="40" FontSize="18" Click="Plus_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
