<UserControl x:Class="EduKit.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="启动与服务" Style="{StaticResource H1}" />
            <TextBlock Text="管理开机启动项和 Windows 服务，排查开机慢、软件自启的问题" Style="{StaticResource Sub}"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="开机启动项" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Button Content="刷新" Style="{StaticResource BtnSubtleSmall}" HorizontalAlignment="Right"
                                Click="RefreshStartup_Click" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="删除所选" Style="{StaticResource BtnDanger}" Click="DeleteStartup_Click" />
                            <Button Content="任务管理器" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="TaskManager_Click" />
                            <Button Content="msconfig" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="Msconfig_Click" />
                        </StackPanel>
                        <TextBlock Text="删除注册表启动项会立即生效；系统关键启动项建议在任务管理器中禁用。"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="StartupList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardAlt}" CornerRadius="6" Padding="10,8"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Windows 服务" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Button Content="刷新" Style="{StaticResource BtnSubtleSmall}" HorizontalAlignment="Right"
                                Click="RefreshServices_Click" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="启动" Style="{StaticResource BtnSmall}" Click="StartService_Click" />
                            <Button Content="停止" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="StopService_Click" />
                            <Button Content="重启" Style="{StaticResource BtnSmall}" Margin="8,0,0,0"
                                    Click="RestartService_Click" />
                            <Button Content="服务管理器" Style="{StaticResource BtnSubtleSmall}" Margin="8,0,0,0"
                                    Click="Services_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ServiceHint" Text="启动 / 停止服务通常需要管理员权限。"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="ServiceList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCardAlt}" CornerRadius="6" Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                                <Run Text="{Binding Name}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding StartType}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoft}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="运行中" FontSize="10"
                                                       Foreground="{DynamicResource Success}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>